# ตัวแปรของแอป — ใส่ทั้งบนเครื่อง (.env.local) และบน Vercel
# anon key ปลอดภัยที่จะเปิดเผย เพราะ RLS เป็นตัวคุมสิทธิ์จริง
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY ไม่ได้อยู่ในไฟล์นี้โดยตั้งใจ
# มันข้าม RLS ทั้งหมด และใช้แค่ตอนรัน tools/seed.mjs บนเครื่องเท่านั้น
# ให้ใส่ใน .env.local เองตอนจะ seed แล้วห้ามใส่บน Vercel เด็ดขาด
